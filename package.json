{
  "name": "sherlook",
  "version": "0.1.2",
  "description": "AI-powered developer assistant CLI.",
  "type": "module",
  "bin": {
    "sherlook": "dist/bin/sherlook.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin/sherlook.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "@google/genai": "^0.7.0",
    "inquirer": "^9.2.17",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.13.0",
    "typescript": "^5.6.3"
  }
}
